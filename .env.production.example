# ============================================================================
# Vibe-Trading VPS Production Environment Configuration
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
HOST_PORT=3000
API_PORT=8899

# AI & LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Trading Engine Execution Configuration
TRADING_MODE=paper              # 'paper' or 'live'
ENABLE_LIVE_TRADING=false       # Switch to true when approved for live execution
REQUIRE_MANUAL_APPROVAL=false   # Set to true to require human confirmation per order
TESTNET_ENABLED=true            # OKX Demo / Testnet futures

# OKX API Credentials (for Testnet or Live execution)
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_SIMULATOR=1                 # 1 for Demo/Testnet, 0 for Real Live Trading

# Database Security & Persistence
POSTGRES_PASSWORD=generate_a_strong_database_password_here_12345
VIBE_PAPER_DATABASE_URL=postgresql://vibe_user:${POSTGRES_PASSWORD}@paper-db:5432/vibe_trading

# Neon Database Data API & Auth (App Name: vibe-box)
VITE_NEON_DATA_API_URL=https://ep-young-cherry-atuvqj2f.apirest.c-9.us-east-1.aws.neon.tech/neondb/rest/v1
VITE_NEON_AUTH_URL=https://ep-young-cherry-atuvqj2f.neonauth.c-9.us-east-1.aws.neon.tech/neondb/auth
VITE_NEON_JWKS_URL=https://ep-young-cherry-atuvqj2f.neonauth.c-9.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Monitoring & Logs
LOG_LEVEL=info
MAX_POSITION_LEVERAGE=10
AUTO_RECOVERY_ON_CRASH=true
