# ============================================================================
# Stage 1: Build Frontend
# ============================================================================
FROM node:20-slim AS frontend-build

WORKDIR /app
COPY package.json package-lock.json* ./
COPY frontend/package.json frontend/
RUN npm ci --ignore-scripts || npm install

COPY frontend/ ./frontend/
COPY tsconfig.json* tailwind.config.ts* postcss.config.js* ./
RUN npm run build

# ============================================================================
# Stage 2: Production Full-Stack Runtime
# ============================================================================
FROM node:20-slim AS runtime

LABEL org.opencontainers.image.title="Vibe-Trading Continuous VPS Runtime" \
      org.opencontainers.image.description="Continuous 24/7 Autonomous Trading & AI System" \
      org.opencontainers.image.version="0.1.10"

WORKDIR /app

# Install system utilities and Python runtime if needed for backtest engines
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Copy package manifests & install production dependencies
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts || npm install --omit=dev

# Install global tsx for direct TypeScript execution in server
RUN npm install -g tsx typescript

# Copy server code and shared configs
COPY server/ ./server/
COPY shared/ ./shared/ 2>/dev/null || true
COPY backend/ ./backend/ 2>/dev/null || true

# Copy built frontend assets to be served statically
COPY --from=frontend-build /app/frontend/dist ./frontend/dist

# Create runtime directories for data persistence and logs
RUN mkdir -p /app/data /app/logs /app/agent/runs /app/agent/paper_sessions \
    && useradd --create-home --shell /bin/bash vibe \
    && chown -R vibe:vibe /app /home/vibe

USER vibe

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0

EXPOSE 3000 8899

# Built-in health check for Docker and container orchestrators
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3000/api/health || curl -fsS http://127.0.0.1:3000/ || exit 1

# Launch the continuous production server
CMD ["tsx", "server/index.ts"]
