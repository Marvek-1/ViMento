# ============================================================================
# Production Environment Variables for vt.mostarindustries.com
# ============================================================================

# Domain & Server Topology
APP_DOMAIN=vt.mostarindustries.com
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security & Secrets
SESSION_SECRET=vibe_ultra_secure_session_token_replace_me_2026

# PostgreSQL Database Configuration
POSTGRES_DB=vibe_trading
POSTGRES_USER=vibe_user
POSTGRES_PASSWORD=vibe_secure_pass_2026
VIBE_PAPER_DATABASE_URL=postgresql://vibe_user:vibe_secure_pass_2026@postgres:5432/vibe_trading

# Neon Database Data API & Auth (App Name: vibe-box)
VITE_NEON_DATA_API_URL=https://ep-young-cherry-atuvqj2f.apirest.c-9.us-east-1.aws.neon.tech/neondb/rest/v1
VITE_NEON_AUTH_URL=https://ep-young-cherry-atuvqj2f.neonauth.c-9.us-east-1.aws.neon.tech/neondb/auth
VITE_NEON_JWKS_URL=https://ep-young-cherry-atuvqj2f.neonauth.c-9.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# AI Research & Optimization Providers
GEMINI_API_KEY=

# Trading Execution Configuration
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
REQUIRE_MANUAL_APPROVAL=false

# OKX API Configuration (for Testnet Simulator or Real Execution)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_SIMULATOR=1

# SSL & Notifications
LETSENCRYPT_EMAIL=admin@mostarindustries.com
