
# Enforce LF for source files (Windows editors were introducing CRLF churn)
*.py   text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Windows Zone.Identifier alternate-data-stream artifacts
*:Zone.Identifier -text -diff
